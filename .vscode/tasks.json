{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Build Raylib Game",
            "type": "process",
            "command": "C:\\raylib\\w64devkit\\bin\\g++.exe",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-I",
                "C:\\raylib\\w64devkit\\include",
                "-L",
                "C:\\raylib\\w64devkit\\lib",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },

        {
            "label": "Build and Run Raylib Game",
            "type": "process",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "Build Raylib Game",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}